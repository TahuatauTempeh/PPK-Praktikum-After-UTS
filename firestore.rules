rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAsisten() {
      return isAuthenticated() && getUserData().role == 'asisten';
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().isAdmin == true;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function laboratoryIsActive(labId) {
      return labId is string
        && labId != ''
        && exists(/databases/$(database)/documents/laboratories/$(labId))
        && get(/databases/$(database)/documents/laboratories/$(labId)).data.isActive == true;
    }

    function isValidLaboratory(data) {
      return data.keys().hasAll([
          'name', 'code', 'building', 'floor', 'room', 'latitude', 'longitude',
          'radiusMeters', 'description', 'isActive', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.code is string && data.code.size() > 0 && data.code.size() <= 20
        && data.building is string && data.building.size() > 0 && data.building.size() <= 80
        && data.floor is string && data.floor.size() <= 20
        && data.room is string && data.room.size() > 0 && data.room.size() <= 40
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.radiusMeters is number && data.radiusMeters >= 10 && data.radiusMeters <= 500
        && data.description is string && data.description.size() <= 200
        && data.isActive is bool
        && data.updatedBy is string && data.updatedBy.size() > 0;
    }

    // ─── 1. Users Collection ────────────────────────────────────────────────

    match /users/{uid} {
      allow read: if isOwner(uid) || isAsisten();
      allow create: if isOwner(uid)
        && request.resource.data.role == 'praktikan'
        && request.resource.data.isAdmin == false;
      allow update: if isAuthenticated() && (
        (isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.isAdmin == resource.data.isAdmin)
        || (isAdmin()
          && request.auth.uid != uid
          && resource.data.isAdmin == false
          && request.resource.data.isAdmin == resource.data.isAdmin
          && request.resource.data.role in ['praktikan', 'asisten']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'roleUpdatedBy', 'roleUpdatedAt', 'updatedAt']))
      );
      allow delete: if false;
    }

    // ─── 2. Classes Collection (Dev 2) ──────────────────────────────────────

    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAsisten();
    }

    // ─── 3. Enrollments Collection (Dev 2) ──────────────────────────────────

    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAsisten());
      allow write: if isAsisten();
    }

    // ─── 4. Sessions Collection (Dev 2 & Dev 3) ─────────────────────────────
    // Hanya asisten yang bisa create, update (buka/tutup sesi), atau delete.
    // Praktikan hanya bisa read.
    // Sprint 3: dokumen yang berstatus 'open' wajib merujuk laboratorium yang ada.

    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAsisten()
        && request.resource.data.status == 'scheduled'
        && laboratoryIsActive(request.resource.data.laboratoryId);
      allow update: if isAsisten()
        && (
          request.resource.data.status == resource.data.status
          || (resource.data.status == 'scheduled' && request.resource.data.status == 'open')
          || (resource.data.status == 'open' && request.resource.data.status == 'closed')
        )
        && (
          request.resource.data.status != 'open'
          || laboratoryIsActive(request.resource.data.laboratoryId)
        );
      allow delete: if isAsisten();
    }

    // ─── 4a. Laboratories Collection (Dev 1) ────────────────────────────────
    // Dibaca semua pengguna login agar peta dan pemilih sesi bekerja. Hanya
    // asisten yang boleh menulis; lab tidak dihapus permanen (soft delete).

    match /laboratories/{labId} {
      allow read: if isAuthenticated();
      allow create: if isAsisten()
        && isValidLaboratory(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAsisten()
        && isValidLaboratory(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ─── 5. Attendance Collection (Dev 1 rules / Dev 2 callable) ────────────
    // ID dokumen: {sessionId}_{uid}
    // Aturan pencegahan:
    //  - Read hanya untuk pemilik catatan atau asisten. Koordinat presensi adalah
    //    data pribadi; jangan membuka seluruh koleksi ke semua user yang login.
    //  - userId harus sesuai auth.uid
    //  - docId harus gabungan sessionId + '_' + uid
    //  - Praktikan hanya bisa create (update ditolak -> cegah presensi ganda)
    //  - Hanya asisten yang bisa update/delete catatan presensi
    //
    // Selama project masih Spark (PRD 14.1), create memakai `validAttendanceCreate`
    // dari transaksi klien. Rules memeriksa pemilik, ID, sesi dibuka, enrollment,
    // lab aktif, dan kelengkapan bukti lokasi; jarak, akurasi, dan deteksi lokasi
    // palsu tetap client-enforced. Setelah callable `submitAttendance` ter-deploy,
    // ganti create menjadi `false` (PRD D-02) dan deploy ulang rules. Jangan
    // membalik urutan deploy.
    function validAttendanceCreate(attendanceId) {
      let d = request.resource.data;
      let sesiPath = /databases/$(database)/documents/sessions/$(d.sessionId);
      return getUserData().role == 'praktikan'
        && d.keys().hasOnly([
          'sessionId', 'userId', 'userName', 'userNim', 'recordedAt', 'latitude', 'longitude',
          'accuracyMeters', 'distanceMeters', 'radiusMeters', 'laboratoryId',
          'locationVerifiedAt', 'mocked', 'source'
        ])
        && d.sessionId is string
        && d.userId == request.auth.uid
        && attendanceId == d.sessionId + '_' + request.auth.uid
        && d.userName is string
        && d.userNim is string
        && d.recordedAt == request.time
        && d.locationVerifiedAt == request.time
        && d.source == 'location'
        && d.mocked == false
        && d.latitude is number && d.latitude >= -90 && d.latitude <= 90
        && d.longitude is number && d.longitude >= -180 && d.longitude <= 180
        && d.accuracyMeters is number && d.accuracyMeters >= 0 && d.accuracyMeters <= 100
        && exists(sesiPath)
        && get(sesiPath).data.status == 'open'
        && exists(/databases/$(database)/documents/enrollments/$(get(sesiPath).data.classId + '_' + request.auth.uid))
        && d.laboratoryId == get(sesiPath).data.laboratoryId
        && laboratoryIsActive(d.laboratoryId)
        && d.radiusMeters == get(/databases/$(database)/documents/laboratories/$(d.laboratoryId)).data.radiusMeters
        && d.distanceMeters is number && d.distanceMeters >= 0 && d.distanceMeters <= d.radiusMeters;
    }

    match /attendance/{attendanceId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAsisten());
      allow create: if isAuthenticated() && validAttendanceCreate(attendanceId);
      allow update, delete: if isAsisten();
    }

    // ─── 6. PermissionRequests Collection (Dev 4) ───────────────────────────

    match /permissionRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAsisten());
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAsisten();
      allow delete: if false;
    }

    // ─── 7. AuditLogs Collection ────────────────────────────────────────────

    match /auditLogs/{logId} {
      allow create: if isAuthenticated()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.timestamp == request.time;
      allow read: if isAsisten();
      allow update, delete: if false;
    }

    // ─── 8. NotificationLogs Collection (Sprint 3, Dev 4 via Admin SDK) ─────
    // Hanya Admin SDK (Cloud Functions atau worker Heroku) yang menulis;
    // asisten boleh membaca.

    match /notificationLogs/{logKey} {
      allow read: if isAsisten();
      allow write: if false;
    }

    // Baseline internal worker notifikasi. Tidak boleh diakses klien.
    match /notificationState/{docId} {
      allow read, write: if false;
    }

    // ─── 8a. KesanPesan Collection (kesan pesan sesi + label AI) ────────────
    // ID dokumen {sessionId}_{uid}, sama dengan attendance, jadi:
    //  - satu kesan pesan per praktikan per sesi (create kedua dianggap update -> ditolak)
    //  - hanya praktikan yang presensinya tercatat di sesi itu
    //  - sesi harus sudah ditutup
    //  - label AI dari aplikasi hanya bahan pertimbangan asisten (null = tidak terbaca)
    //  - tidak bisa diubah atau dihapus

    match /kesanPesan/{kesanId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAsisten());
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'sessionId', 'classId', 'userId', 'userName', 'text', 'aiLabel', 'aiConfidence', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sessionId is string
        && kesanId == request.resource.data.sessionId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/attendance/$(kesanId))
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'closed'
        && request.resource.data.classId is string
        && request.resource.data.userName is string
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10
        && request.resource.data.text.size() <= 500
        && (request.resource.data.aiLabel == null
          || request.resource.data.aiLabel in ['negatif', 'netral', 'positif'])
        && (request.resource.data.aiConfidence == null
          || (request.resource.data.aiConfidence is number
            && request.resource.data.aiConfidence >= 0
            && request.resource.data.aiConfidence <= 1))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ─── 9. InvitationCodes Collection (Dev 1) ──────────────────────────────

    match /invitationCodes/{code} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid;
      allow create, delete: if isAdmin();
    }
  }
}