rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAsisten() {
      return isAuthenticated() && getUserData().role == 'asisten';
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().isAdmin == true;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Laboratorium dengan ID tertentu ada di koleksi laboratories (Sprint 3)
    function laboratoryExists(labId) {
      return labId is string
        && labId.size() > 0
        && exists(/databases/$(database)/documents/laboratories/$(labId));
    }

    // ─── 1. Users Collection ────────────────────────────────────────────────

    match /users/{uid} {
      allow read: if isOwner(uid) || isAsisten();
      allow create: if isOwner(uid)
        && request.resource.data.role == 'praktikan'
        && request.resource.data.isAdmin == false;
      allow update: if isAuthenticated() && (
        (isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.isAdmin == resource.data.isAdmin)
        || (isAdmin()
          && request.auth.uid != uid
          && resource.data.isAdmin == false
          && request.resource.data.isAdmin == resource.data.isAdmin
          && request.resource.data.role in ['praktikan', 'asisten']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'roleUpdatedBy', 'roleUpdatedAt', 'updatedAt']))
      );
      allow delete: if false;
    }

    // ─── 2. Classes Collection (Dev 2) ──────────────────────────────────────

    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAsisten();
    }

    // ─── 3. Enrollments Collection (Dev 2) ──────────────────────────────────

    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAsisten());
      allow write: if isAsisten();
    }

    // ─── 4. Sessions Collection (Dev 2 & Dev 3) ─────────────────────────────
    // Hanya asisten yang bisa create, update (buka/tutup sesi), atau delete.
    // Praktikan hanya bisa read.
    // Sprint 3: dokumen yang berstatus 'open' wajib merujuk laboratorium yang ada.

    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAsisten()
        && (request.resource.data.status != 'open'
            || laboratoryExists(request.resource.data.get('laboratoryId', '')));
      allow delete: if isAsisten();
    }

    // ─── 5. Attendance Collection (Dev 3) ───────────────────────────────────
    // ID dokumen: {sessionId}_{uid}
    // Aturan pencegahan:
    //  - Read diperbolehkan untuk semua user yang login (untuk cek kehadiran)
    //  - userId harus sesuai auth.uid
    //  - docId harus gabungan sessionId + '_' + uid
    //  - Praktikan hanya bisa create (update ditolak -> cegah presensi ganda)
    //  - Hanya asisten yang bisa update/delete catatan presensi
    //
    // CATATAN DEPLOY SPRINT 3: aturan create di bawah masih aturan Sprint 2 supaya
    // presensi tetap berjalan sebelum callable `submitAttendance` ter-deploy.
    // Setelah callable aktif (CP4), ganti baris `allow create` menjadi `allow create: if false;`
    // dan deploy ulang rules. Jangan membalik urutan ini.

    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && attendanceId == request.resource.data.sessionId + '_' + request.auth.uid;
      allow update, delete: if isAsisten();
    }

    // ─── 6. PermissionRequests Collection (Dev 4) ───────────────────────────

    match /permissionRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAsisten());
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAsisten();
      allow delete: if false;
    }

    // ─── 7. AuditLogs Collection ────────────────────────────────────────────

    match /auditLogs/{logId} {
      allow create: if isAuthenticated()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.timestamp == request.time;
      allow read: if isAsisten();
      allow update, delete: if false;
    }

    // ─── 8. Laboratories Collection (Sprint 3, Dev 1) ───────────────────────
    // Semua pengguna login boleh membaca (peta, presensi). Hanya asisten yang menulis.
    // Laboratorium tidak dihapus permanen (soft delete lewat isActive), jadi delete ditolak.
    // Koordinat dan radius divalidasi di rules sebagai lapis kedua setelah validasi klien.

    function validLaboratoryData(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.code is string && data.code.size() > 0 && data.code.size() <= 20
        && data.building is string && data.building.size() > 0 && data.building.size() <= 80
        && data.room is string && data.room.size() > 0 && data.room.size() <= 40
        && data.get('floor', '') is string && data.get('floor', '').size() <= 20
        && data.get('description', '') is string && data.get('description', '').size() <= 200
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.radiusMeters is number && data.radiusMeters >= 10 && data.radiusMeters <= 500
        && data.isActive is bool
        && data.updatedBy == request.auth.uid;
    }

    match /laboratories/{labId} {
      allow read: if isAuthenticated();
      allow create, update: if isAsisten() && validLaboratoryData(request.resource.data);
      allow delete: if false;
    }

    // ─── 9. NotificationLogs Collection (Sprint 3, Dev 4 via Functions) ─────
    // Hanya Cloud Functions (Admin SDK) yang menulis; asisten boleh membaca.

    match /notificationLogs/{logKey} {
      allow read: if isAsisten();
      allow write: if false;
    }

    // ─── 10. InvitationCodes Collection (Dev 1) ─────────────────────────────

    match /invitationCodes/{code} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid;
      allow create, delete: if isAdmin();
    }
  }
}